<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Transporte inteligente na Colômbia</title>
<meta name="description" content="Como funcionam o TransMilenio, o metrô e o Metrocable de Medellín, as ciclovias e os ônibus elétricos nas cidades colombianas, com seus benefícios, desafios e impactos.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap" rel="stylesheet">
<style>
:root{
  --yellow:#FCD116; --blue:#003893; --red:#CE1126; --deep:#0B2A70;
  --bg:#F5F7FC; --surface:#FFFFFF; --text:#14203C; --muted:#4B5877; --border:#D9DEEC;
  --ink:#003893; --tint-y:#FFF2B3; --tint-b:#E2EAFA; --tint-r:#FBE2E5;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0B1120; --surface:#141C30; --text:#EDF0F8; --muted:#A9B3CE; --border:#28345A;
    --ink:#9DBBFF; --tint-y:#3A3310; --tint-b:#14264D; --tint-r:#3B1319;
  }
}
:root[data-theme="dark"]{
  --bg:#0B1120; --surface:#141C30; --text:#EDF0F8; --muted:#A9B3CE; --border:#28345A;
  --ink:#9DBBFF; --tint-y:#3A3310; --tint-b:#14264D; --tint-r:#3B1319;
}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px);}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth;}}
*,*::before,*::after{box-sizing:inherit;}
body{margin:0;background:var(--bg);color:var(--text);font-family:'Literata',Georgia,'Times New Roman',serif;font-size:1.0625rem;line-height:1.7;-webkit-text-size-adjust:100%;}
h1,h2,h3,h4,.sans{font-family:'Bricolage Grotesque','Trebuchet MS','Segoe UI',system-ui,sans-serif;}
img,svg{max-width:100%;display:block;}
a{color:var(--ink);}
:focus-visible{outline:3px solid var(--red);outline-offset:3px;border-radius:4px;}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px;}

/* Navegação */
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--surface);border-bottom:1px solid var(--border);}
.topbar::after{content:"";position:absolute;left:0;right:0;bottom:-5px;height:4px;background:linear-gradient(90deg,var(--yellow) 0 50%,var(--blue) 50% 75%,var(--red) 75% 100%);}
.topbar-in{max-width:1120px;margin:0 auto;padding:8px 20px;display:flex;align-items:center;gap:14px;}
.brand{font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;font-size:1.15rem;text-decoration:none;color:var(--ink);flex:none;line-height:1.1;}
.topbar nav{flex:1;min-width:0;}
.topbar ul{list-style:none;margin:0;padding:0;display:flex;gap:4px;overflow-x:auto;position:relative;scrollbar-width:none;}
.topbar ul::-webkit-scrollbar{display:none;}
.topbar nav a{display:block;white-space:nowrap;padding:8px 13px;border-radius:999px;font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:500;font-size:.92rem;text-decoration:none;color:var(--text);}
.topbar nav a:hover{background:var(--tint-b);}
.topbar nav a.on{background:var(--blue);color:#fff;}

/* Hero azul, com faixa amarela e vermelha embaixo */
.hero{background:var(--blue);color:#fff;padding:56px 0 64px;margin-top:5px;}
.hero-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:40px;align-items:center;}
.hero h1{font-weight:800;font-size:clamp(2.2rem,5.2vw,3.7rem);line-height:1.05;margin:0 0 18px;letter-spacing:-.02em;color:#fff;}
.hero p.lead{font-size:1.15rem;max-width:34em;margin:0 0 26px;color:#E4ECFF;}
.btns{display:flex;flex-wrap:wrap;gap:12px;}
.btn{display:inline-block;padding:13px 22px;border-radius:12px;font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:700;text-decoration:none;font-size:1rem;}
.btn.primary{background:var(--yellow);color:#0B1F4D;}
.btn.ghost{border:2px solid #fff;color:#fff;}
.hero figure{margin:0;border-radius:22px;overflow:hidden;border:4px solid var(--yellow);box-shadow:10px 10px 0 var(--red);}
.facts{background:var(--yellow);color:#0B1F4D;}
.facts dl{max-width:1120px;margin:0 auto;padding:22px 20px;display:grid;grid-template-columns:repeat(5,1fr);gap:18px;}
.facts div{min-width:0;}
.facts dt{font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;font-size:1.7rem;line-height:1;}
.facts dd{margin:4px 0 0;font-size:.92rem;line-height:1.3;}
.redband{height:14px;background:var(--red);}

/* Seções */
.sec{position:relative;padding:84px 0 72px;--accent:var(--yellow);--onaccent:#0B1F4D;}
.sec.alt{background:var(--surface);}
.sec + .sec::before{content:"";position:absolute;left:0;right:0;top:0;height:6px;background:linear-gradient(90deg,var(--yellow) 0 50%,var(--blue) 50% 75%,var(--red) 75% 100%);}
.sec.b{--accent:var(--blue);--onaccent:#fff;}
.sec.r{--accent:var(--red);--onaccent:#fff;}
.sec-head{margin-bottom:34px;}
.sec-head h2{display:flex;align-items:center;gap:14px;font-size:clamp(1.8rem,4vw,2.6rem);line-height:1.1;margin:0 0 14px;color:var(--ink);letter-spacing:-.015em;}
.stop{flex:none;display:inline-flex;align-items:center;justify-content:center;width:2.1em;height:2.1em;border-radius:50%;background:var(--accent);color:var(--onaccent);font-size:.7em;font-weight:800;border:3px solid var(--surface);box-shadow:0 0 0 3px var(--accent);}
.sec-head p{margin:0;max-width:44em;font-size:1.15rem;color:var(--muted);}
h3{font-size:1.45rem;line-height:1.2;margin:34px 0 10px;color:var(--ink);}
h4{font-size:1.15rem;line-height:1.25;margin:0 0 6px;}
p{margin:0 0 1em;max-width:42em;}
.split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:start;}
.split.rev > :first-child{order:2;}
figure{margin:0;}
.fig{border-radius:18px;overflow:hidden;border:1px solid var(--border);background:var(--surface);}
figcaption{font-size:.9rem;color:var(--muted);padding:10px 4px 0;font-style:italic;line-height:1.5;}
.sticky{position:sticky;top:calc(env(safe-area-inset-top,0px) + 84px);}

.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin:18px 0 0;}
.card{background:var(--surface);border:1px solid var(--border);border-top:6px solid var(--c,var(--yellow));border-radius:14px;padding:18px 18px 8px;}
.alt .card{background:var(--bg);}
.card:nth-child(3n+1){--c:var(--yellow);}
.card:nth-child(3n+2){--c:var(--blue);}
.card:nth-child(3n){--c:var(--red);}
.card p{font-size:.98rem;line-height:1.6;}
.card .where{font-family:'Bricolage Grotesque',system-ui,sans-serif;font-size:.88rem;color:var(--muted);margin:0 0 8px;font-weight:500;}

.fact{background:var(--tint-y);border-left:6px solid var(--yellow);border-radius:0 12px 12px 0;padding:14px 18px 2px;margin:24px 0;max-width:42em;}
.fact.b{background:var(--tint-b);border-color:var(--blue);}
.fact.r{background:var(--tint-r);border-color:var(--red);}
.fact strong:first-child{font-family:'Bricolage Grotesque',system-ui,sans-serif;}
.note{font-size:.88rem;color:var(--muted);line-height:1.55;max-width:46em;}

.chips{list-style:none;margin:16px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;}
.chips li{background:var(--tint-b);border-radius:12px;padding:12px 16px;font-size:.98rem;line-height:1.55;}
.chips li:nth-child(3n+1){background:var(--tint-y);}
.chips li:nth-child(3n){background:var(--tint-r);}
.chips b{font-family:'Bricolage Grotesque',system-ui,sans-serif;}

.pillars{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin:20px 0 0;}
.pillar{border-radius:16px;padding:18px 18px 6px;background:var(--tint-b);}
.pillar:nth-child(4n+1){background:var(--tint-y);}
.pillar:nth-child(4n+3){background:var(--tint-r);}
.pillar svg{width:52px;height:52px;margin-bottom:8px;}
.pillar p{font-size:.97rem;line-height:1.6;}

.scroll{overflow-x:auto;border:1px solid var(--border);border-radius:14px;margin:16px 0;}
table{border-collapse:collapse;width:100%;min-width:560px;font-size:.96rem;line-height:1.5;background:var(--surface);}
.alt table{background:var(--bg);}
th,td{text-align:left;padding:11px 14px;border-bottom:1px solid var(--border);vertical-align:top;}
th{font-family:'Bricolage Grotesque',system-ui,sans-serif;background:var(--tint-b);color:var(--ink);}
tr:last-child td{border-bottom:0;}

.steps{list-style:none;margin:14px 0 0;padding:0;counter-reset:s;max-width:44em;}
.steps li{counter-increment:s;position:relative;padding:0 0 18px 56px;}
.steps li::before{content:counter(s);position:absolute;left:0;top:0;width:38px;height:38px;border-radius:50%;background:var(--c,var(--yellow));color:var(--cc,#0B1F4D);display:flex;align-items:center;justify-content:center;font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;}
.steps li:nth-child(3n+2){--c:var(--blue);--cc:#fff;}
.steps li:nth-child(3n){--c:var(--red);--cc:#fff;}
.steps b{font-family:'Bricolage Grotesque',system-ui,sans-serif;display:block;margin-bottom:2px;}
.steps p{margin:0;}

.timeline{list-style:none;margin:10px 0 0;padding:0 0 0 30px;border-left:4px solid var(--border);}
.timeline li{position:relative;padding:0 0 22px 22px;max-width:46em;}
.timeline li::before{content:"";position:absolute;left:-44px;top:7px;width:18px;height:18px;border-radius:50%;background:var(--c,var(--yellow));border:4px solid var(--surface);box-shadow:0 0 0 2px var(--c,var(--yellow));}
.timeline li:nth-child(3n+1){--c:var(--yellow);}
.timeline li:nth-child(3n+2){--c:var(--blue);}
.timeline li:nth-child(3n){--c:var(--red);}
.timeline .yr{display:block;font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;font-size:1.15rem;color:var(--ink);}
.timeline p{margin:2px 0 0;}

.chart{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px 20px 12px;margin:20px 0;max-width:44em;}
.alt .chart{background:var(--bg);}
.chart h4{margin-bottom:12px;}
.bar{display:grid;grid-template-columns:minmax(110px,34%) 1fr;gap:12px;align-items:center;margin:0 0 10px;font-size:.95rem;line-height:1.3;}
.bar .track{background:var(--tint-b);border-radius:8px;height:30px;position:relative;overflow:hidden;}
.bar .fill{height:100%;border-radius:8px;background:var(--blue);display:flex;align-items:center;justify-content:flex-end;padding-right:10px;color:#fff;font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:700;font-size:.9rem;}
.bar .fill.y{background:var(--yellow);color:#0B1F4D;}
.bar .fill.r{background:var(--red);}
.chart .note{margin:8px 0 6px;}

.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;margin-top:10px;}
.tile{border-radius:16px;padding:18px 20px 6px;background:var(--tint-b);}
.tile:nth-child(3n+1){background:var(--tint-y);}
.tile:nth-child(3n){background:var(--tint-r);}
.tile h4{color:var(--ink);}
.tile p{font-size:.98rem;line-height:1.6;}

ul.plain{padding-left:1.2em;margin:0 0 1em;max-width:42em;}
ul.plain li{margin-bottom:.4em;}
ol.legend{list-style:none;margin:0;padding:0;max-width:42em;}
ol.legend li{display:grid;grid-template-columns:34px 1fr;gap:10px;align-items:start;margin-bottom:12px;}
ol.legend .n{width:30px;height:30px;border-radius:50%;background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;font-size:.9rem;}
ol.legend li:first-child .n{background:var(--red);}
ol.legend p{margin:0;font-size:.97rem;line-height:1.55;}

footer{background:var(--blue);color:#fff;padding:40px 0 34px;position:relative;}
footer::before{content:"";position:absolute;left:0;right:0;top:-6px;height:6px;background:linear-gradient(90deg,var(--yellow) 0 50%,#fff 50% 50%,var(--red) 75% 100%);}
footer .wrap{display:grid;gap:12px;}
footer p{margin:0;max-width:56em;font-size:.93rem;line-height:1.6;}
footer .name{font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;font-size:1.4rem;}
footer ul{margin:0;padding-left:1.2em;font-size:.9rem;line-height:1.6;max-width:56em;}
footer a{color:var(--yellow);}

svg text{font-family:'Bricolage Grotesque','Trebuchet MS',system-ui,sans-serif;}

@media (max-width:900px){
  .hero-grid,.split{grid-template-columns:1fr;gap:28px;}
  .split.rev > :first-child{order:0;}
  .sticky{position:static;}
  .facts dl{grid-template-columns:repeat(2,1fr);}
  .sec{padding:68px 0 56px;}
  .brand{font-size:1.05rem;}
}
@media (max-width:520px){
  .wrap{padding:0 16px;}
  .hero{padding:36px 0 44px;}
  .hero figure{box-shadow:6px 6px 0 var(--red);}
  body{font-size:1rem;}
  .bar{grid-template-columns:1fr;gap:4px;}
}
</style>
</head>
